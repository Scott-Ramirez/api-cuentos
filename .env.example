# =============================================================
#  api-cuentos — Variables de entorno
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas .env al repositorio.
# =============================================================

# -------------------------------------------------------------
# ENTORNO
# -------------------------------------------------------------
NODE_ENV=development          # development | production | test
PORT=3000

# -------------------------------------------------------------
# BASE DE DATOS (MySQL)
# -------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=tu_password_aqui
DATABASE_NAME=mycuento_db

# -------------------------------------------------------------
# JWT
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -------------------------------------------------------------
JWT_SECRET=reemplaza_con_un_secreto_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# CORS
# Múltiples orígenes separados por coma.
# Soporta regex con prefijo "regex:" → regex:https://.*\.tudominio\.com$
# -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001

# -------------------------------------------------------------
# ARCHIVOS / UPLOADS
# MAX_FILE_SIZE en bytes (5242880 = 5 MB)
# -------------------------------------------------------------
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE=5242880
